# Copy to .env.local (local) or set in Vercel → Project → Settings → Environment Variables.

# Canonical origin used in metadata, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.silvertouchhospitals.com

# ---- Form delivery [CONFIRM] — set at least one, or production forms show "please call us" ----
# Email via Resend (https://resend.com). Appointment requests go to the chosen branch inbox,
# job applications to the HR inbox.
RESEND_API_KEY=
FORM_FROM_EMAIL="Silver Touch Website <website@silvertouchhospitals.com>"
# Any JSON webhook: Google Apps Script → Sheet, Zapier/Make, or a CRM endpoint.
FORM_WEBHOOK_URL=

# ---- Spam protection (optional) — reCAPTCHA v3 ----
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ---- Analytics [CONFIRM] ----
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---- Optional ----
# WhatsApp number (digits, with country code) — adds WhatsApp to the mobile action bar.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Embeddable Instagram feed URL (Behold, SnapWidget, …) for /media/.
NEXT_PUBLIC_INSTAGRAM_FEED_URL=
# Show [CONFIRM] placeholders: "true" on staging, "false" to hide them in dev.
# Production builds hide them by default.
NEXT_PUBLIC_SHOW_CONFIRM=
